---
import SITE_CONFIG from "@/config";
import Svg from "@/components/Svg/Svg.astro";
import "./Footer.less";
const { Title, Author, CreateTime, HanAnalytics, Site, ICPNumber } = SITE_CONFIG;
const startYear = new Date(CreateTime).getFullYear();
const currentYear = new Date().getFullYear();
const years = startYear === currentYear ? `${startYear}` : `${startYear}–${currentYear}`;
---

<footer class="vh-footer">
  <main>
    <p class="footer-owner">© {years} {Author} · {Title}</p>
    <p class="footer-links">
      <a href="/about">
        <span class="footer-link-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="3" />
            <path d="M5 21v-2a7 7 0 0 1 14 0v2" />
          </svg>
        </span>
        关于我
      </a>
      <a href="https://github.com/ltz150" target="_blank" rel="noopener noreferrer">
        <span class="footer-link-icon" aria-hidden="true"><Svg src="WebSite_github" /></span>
        GitHub
      </a>
      <a href="/rss.xml">
        <span class="footer-link-icon" aria-hidden="true"><Svg src="Nav_rss" /></span>
        RSS 订阅
      </a>
      <a href="/sitemap-index.xml">
        <span class="footer-link-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="3" width="6" height="5" rx="1" />
            <rect x="3" y="16" width="6" height="5" rx="1" />
            <rect x="15" y="16" width="6" height="5" rx="1" />
            <path d="M12 8v4M6 16v-4h12v4" />
          </svg>
        </span>
        站点地图
      </a>
      {HanAnalytics.enable && <a href={HanAnalytics.url} target="_blank" rel="noopener noreferrer" data-no-swup>
        <span class="footer-link-icon" aria-hidden="true"><Svg src="WebSite_analytics" /></span>
        访问统计
      </a>}
    </p>
    {ICPNumber && <p class="footer-links footer-registration">
      <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer" data-no-swup>
        <span class="footer-link-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6l-8-3Z" />
            <path d="m8 12 3 3 5-6" />
          </svg>
        </span>
        {ICPNumber}
      </a>
    </p>}
    <p><span><cite>运行时间</cite><em class="web_time"></em></span></p>
  </main>
</footer>
{HanAnalytics.enable && <script is:inline defer src={`${HanAnalytics.url}/tracker.js`} data-website-id={HanAnalytics.websiteId} data-host={new URL(Site).hostname}></script>}
