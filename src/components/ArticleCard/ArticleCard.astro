---
import { getDescription, fmtTime } from "@/utils/index";
const { post } = Astro.props;
// 获取文章的摘要
const description = getDescription(post);
// 获取封面图
import getCover from "@/utils/getCover";
const ARTICLE_COVER: string = await getCover(post.data.cover);
// WordPress 图片代理支持缩略图参数，避免卡片下载原始大图。
const thumbnail = new URL(ARTICLE_COVER, Astro.site);
let coverSrcset: string | undefined;
if (thumbnail.hostname === 'i0.wp.com') {
	thumbnail.searchParams.set('w', '800');
	thumbnail.searchParams.set('quality', '75');
	const small = new URL(thumbnail);
	small.searchParams.set('w', '400');
	coverSrcset = `${small.href} 400w, ${thumbnail.href} 800w`;
}
// 文章Item组件样式
import "./ArticleCard.less";
---

<article class={`vh-article-item vh-animation vh-animation-init vh-article-link${post.data.top ? " active" : ""}`}>
	<a class="vh-article-banner" href={`/article/${post.data.id}`} aria-label={`阅读文章：${post.data.title}`}><img src={thumbnail.href} srcset={coverSrcset} sizes={coverSrcset ? "(max-width: 556px) calc(100vw - 22px), (max-width: 888px) calc((100vw - 43px) / 2), (max-width: 1150px) calc((100vw - 361px) / 2), 360px" : undefined} width="800" height="450" loading="lazy" decoding="async" alt={post.data.title} /></a>
	<header>
		<div class="vh-article-meta"><a class={`vh-article-cat vh-cat-${post.data.categories}`} href={`/categories/${post.data.categories}`}>{post.data.categories}</a><time>{fmtTime(post.data.date)}</time></div>
		<h2 class="title"><a class="vh-ellipsis" href={`/article/${post.data.id}`}>{post.data.title}</a></h2>
	</header>
	<p class="vh-article-excerpt vh-ellipsis line-2">{description}</p>
	<div class="vh-article-taglist vh-ellipsis">
		{post.data.tags.map((tag: string) => <a href={`/tag/${tag}`}>{tag}</a>)}
	</div>
</article>
