---
import SITE_INFO from "@/config";
import "./MainHeader.less";
---

<div class="header-main">
	<div class="avatar">
		<img src={SITE_INFO.Avatar} width="136" height="136" decoding="async" alt={SITE_INFO.Author} />
	</div>
	<p class="auther">{SITE_INFO.Author || "-"}</p>
	<p class="desc">{SITE_INFO.TypeWriteList[0] || SITE_INFO.Motto}</p>
</div>
